node_modules/
dist/
*.tsbuildinfo

# bb.js browser build is vendored from node_modules at predev/prebuild
packages/*/public/vendor/

# config/ is an ALLOWLIST: everything in it is ignored unless named here.
# The local.* files hold the auditor key, deployer, shop keypairs, GM token
# and bot seats — a future config/secrets.json must never be committable.
config/*
!config/catalog.json
!config/deployment.testnet.json
!config/shops.testnet.json

# per-machine agent tooling
.claude/
.agents/
skills-lock.json
.env
.env.*
# wrangler dev reads worker secrets from here, NOT from .env — AUDITOR_K,
# the key that decrypts every amount in the game, lives in it.
.dev.vars
.dev.vars.*

.DS_Store
.wrangler/
worker-configuration.d.ts
.playwright-mcp/

# Raw art originals: the app ships compressed copies from
# packages/app/public/. Keeping the sources out of git stops each new
# 20MB video from living in history forever. Backup: ~/gerald-originals
design/videos/
