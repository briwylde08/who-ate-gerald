{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gerald-auditor",
  // SDF ecosystem Cloudflare account (legal, 2026-09-30: hosting moves off
  // personal accounts). Pinned so a deploy can never land elsewhere.
  "account_id": "ba55b7ae9acfb3ed152103e3497c0752",
  // Front door. The stellar.buzz zone lives in the same account, so wrangler
  // creates the DNS record and certificate. workers.dev stays on as a fallback.
  "routes": [{ "pattern": "gerald-auditor.stellar.buzz", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],

  // Public, non-secret configuration. The secrets live in wrangler secrets:
  //   AUDITOR_K        — the auditor scalar k (hex) from config/local.auditor.json
  //   OPENAI_API_KEY   — unused under Unified Billing (set to a placeholder)
  //   OPENAI_BASE_URL  — the gateway's URL, …/{account}/{gateway}/compat
  //   CF_AIG_TOKEN     — the gateway's auth token (config/local.aig.json)
  //   GM_TOKEN         — bearer token for the GM endpoints
  //   SHOP_SECRETS     — JSON { shopId: S...secret }: the shopkeepers' signing
  //                      keys, used at dawn to merge each shop's till. A secret,
  //                      never a var — vars are public in this file.
  "vars": {
    "INDEXER_URL": "https://ember-indexer.briana-761.workers.dev",
    "TOKEN_CONTRACT": "CCLDBRA5UVX6RMXSN44FMLK6RK4XMQ3XELL4TZC6XPL4D2JPPQNI4VSK",
    "OPENAI_MODEL": "gpt-5.5",
    // The gateway pays OpenAI from the SDF account's credits (no OpenAI key).
    "AIG_UNIFIED_BILLING": "true",
    // Freeze-proofing deadlines (ms). These are BACKSTOPS, not a game clock:
    // a day still resolves the instant everyone acts. They only bound how long
    // the game waits on someone who has genuinely gone away.
    //   MARKET_DEADLINE_MS  — after a day opens, force-close the market.
    //   VOTE_DEADLINE_MS    — after market close, force dawn with votes in hand.
    // Raised 5min/2min -> 10min/10min (Bri, 2026-09-01): 2 minutes guillotined
    // the trial mid-argument in a human game (testing-with-patricio ran a day
    // every ~5 min on rails). Deliberation IS the game — give it room.
    "MARKET_DEADLINE_MS": "600000",
    "VOTE_DEADLINE_MS": "600000"
  },

  "durable_objects": {
    "bindings": [
      { "name": "GAMES", "class_name": "GameRoom" },
      { "name": "LOBBIES", "class_name": "LobbyRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyRegistry"] }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
