{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gerald-auditor",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],

  // Public, non-secret configuration. The secrets live in wrangler secrets:
  //   AUDITOR_K        — the auditor scalar k (hex) from config/local.auditor.json
  //   OPENAI_API_KEY   — Maude's voice (via a Cloudflare AI Gateway)
  //   OPENAI_BASE_URL  — the gateway's OpenAI compat URL
  //   CF_AIG_TOKEN     — optional gateway auth
  //   GM_TOKEN         — bearer token for the GM endpoints
  "vars": {
    "INDEXER_URL": "https://ember-indexer.briana-761.workers.dev",
    "TOKEN_CONTRACT": "CCLDBRA5UVX6RMXSN44FMLK6RK4XMQ3XELL4TZC6XPL4D2JPPQNI4VSK",
    "OPENAI_MODEL": "gpt-5.5",
    // Freeze-proofing deadlines (ms): the market auto-closes on a straggler
    // after MARKET_DEADLINE_MS, and dawn auto-resolves on a missing vote/pick
    // MARKET-close + VOTE_DEADLINE_MS. Tune here for demo pacing.
    "MARKET_DEADLINE_MS": "300000",
    "VOTE_DEADLINE_MS": "120000"
  },

  "durable_objects": {
    "bindings": [
      { "name": "GAMES", "class_name": "GameRoom" },
      { "name": "LOBBIES", "class_name": "LobbyRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyRegistry"] }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
