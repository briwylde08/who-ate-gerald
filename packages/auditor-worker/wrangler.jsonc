{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gerald-auditor",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],

  // Public, non-secret configuration. The secrets live in wrangler secrets:
  //   AUDITOR_K        — the auditor scalar k (hex) from config/local.auditor.json
  //   OPENAI_API_KEY   — Maude's voice (via QA's CF AI Gateway, like SCF Review)
  //   OPENAI_BASE_URL  — the gateway's OpenAI compat URL
  //   CF_AIG_TOKEN     — optional gateway auth
  //   GM_TOKEN         — bearer token for the GM endpoints
  "vars": {
    "INDEXER_URL": "https://ember-indexer.briana-761.workers.dev",
    "TOKEN_CONTRACT": "CCLDBRA5UVX6RMXSN44FMLK6RK4XMQ3XELL4TZC6XPL4D2JPPQNI4VSK",
    "OPENAI_MODEL": "gpt-5.5"
  },

  "durable_objects": {
    "bindings": [{ "name": "GAMES", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
